T:system-reader-you-read = [[reader]] You read what the resident has tuned out, and tell them what matters.
T:system-you-are-the = You are the strategy fixture's agent.
T:user-clock-monday-#-#-# = Clock: Monday #-#-#, #:# UTC
T:user-delivered-plain-speech = [delivered] plain speech → chat
T:user-delivered-true = {"delivered":true}
T:user-prose-routing-output-mode = [prose-routing] Output mode changed: plain text is delivered only with a destination prefix line, e.g. ">>#channel-name your text".
T:user-routing-your-plain = [routing] Your plain speech now lands in chat. Other channels need an explicit send tool.
T:user-skipped-true-note-turn-ended-nothing = {"skipped":true,"note":"Turn ended; nothing sent."}
T:user-the-local-time = The local time at the start of this session is #-#-#T#:#:#.#+#:# [UTC].
T:user-tune-out-wake-chat = [Tune-out wake: chat — # addressed message]
T:user-tunedout-chat-cadenceseconds-#-backlogca = {"tunedOut":"chat","cadenceSeconds":#,"backlogCap":#,"maxWakes":#}
