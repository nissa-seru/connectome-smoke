T:user-contextbudgettokens-#-effectivecontextbu = {"contextBudgetTokens":#,"effectiveContextBudgetTokens":#,"tailTokens":#,"sameRoundThinkTextPolicy":"public","sameRoundThinkTextPolicySource":"compatibility_default","transition":"stable","tool_result_inline_max_chars":null,"tool_result_inline_max_chars_effective":#,"tool_result_inline_max_chars_source":"default","tool_result_inline_max_chars_clamped_by":null,"tool_result_guard":true,"tool_result_guard_source":"runtime_override","closed_channel_note":true,"reasoning_enabled":false,"reasoning_budget_tokens":#,"reasoning_display":"summarized","reasoning_effort":"default","channel_idle_limits":{},"channel_idle_default":#,"channel_idle_counters":{},"channel_idle_pinned":[]}
T:user-delivered-plain-speech = [delivered] plain speech → chat
T:user-routing-your-plain = [routing] Your plain speech now lands in chat. Other channels need an explicit send tool.
T:user-settings-open-call = [settings] open: call these with toolsets--act {tool, args}; they aren't in your tool list.
    observers--get() — List who is currently authorized to observe your internals through the web viewer (thinking, tool calls, conversation stream — by scope).
    observers--grant(key: string, label: string, scopes: ("health"|"ops"|"messages"|"tools"|"thinking"|"debug")[], expires?: string) — Authorize an observer key to watch your internals through the web viewer.
    observers--revoke(key?: string, label?: string) — Remove an observer grant by key or by label.
    agent_settings(action: "get"|"update"|"reset"|"cancel", context_budget_tokens?: number, tail_tokens?: number, transition_pace_tokens?: number, immediate?: boolean, same_round_think_text_policy?: "public"|"private", settings?: ("context_budget_tokens"|"tail_tokens"|"transition_pace_tokens"|"same_round_think_text_policy"|"tool_result_inline_max_chars"|"tool_result_guard"|"closed_channel_note"|"reasoning_enabled"|"reasoning_budget_tokens"|"reasoning_display"|"reasoning_effort"|"channel_idle_limits")[], tool_result_inline_max_chars?: number, tool_result_guard?: boolean, closed_channel_note?: boolean, reasoning_enabled?: boolean, reasoning_budget_tokens?: number, reasoning_display?: "summarized"|"omitted", reasoning_effort?: "default"|"low"|"medium"|"high"|"xhigh"|"max", channel_idle_limits?: object) — Read or change your hot runtime settings.
  toolsets--close {toolset:"settings"} closes it.
T:user-the-local-time = The local time at the start of this session is #-#-#T#:#:#.#+#:# [UTC].
