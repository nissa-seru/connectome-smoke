{
  "name": "connectome-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smoke tests for the published Connectome stack and repo mains",
  "scripts": {
    "smoke": "node lanes/published.mjs",
    "smoke:published": "node lanes/published.mjs --lane published",
    "smoke:latest": "node lanes/published.mjs --lane latest",
    "smoke:source": "node lanes/source.mjs",
    "manifest": "node scripts/manifest.mjs",
    "test": "node --test scripts/notify.test.mjs scripts/manifest.test.mjs lib/common.test.mjs"
  },
  "engines": { "node": ">=22.12.0" }
}
